#!/usr/bin/env bash
set -euo pipefail

ARTIFACT_URL='${artifact_url}'
ARTIFACT_PATH='${artifact_path}'
EXPECTED_SHA256='${artifact_sha256}'
DATABASE_SECRET='${database_secret}'
RUNTIME_HTTPS_URL='${runtime_https_url}'

install -d -m 0750 "$(dirname "$ARTIFACT_PATH")"
curl --fail --show-error --silent --location --proto '=https' --tlsv1.2 "$ARTIFACT_URL" -o "$ARTIFACT_PATH"

if [ -n "$EXPECTED_SHA256" ]; then
  printf '%s  %s\n' "$EXPECTED_SHA256" "$ARTIFACT_PATH" | sha256sum -c -
fi

export MYORG_DATABASE_SECRET="$DATABASE_SECRET"
export MYORG_RUNTIME_HTTPS_URL="$RUNTIME_HTTPS_URL"
/bin/bash -lc '${install_command}'
systemctl enable --now '${service_name}'
